{
  "name": "medad-al-tahaya-invitations",
  "version": "3.0.0",
  "private": true,
  "description": "Arabic electronic invitation storefront and event attendance MVP",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-site.mjs",
    "validate": "node scripts/validate.mjs",
    "format:check": "prettier --check '*.html' 'js/*.js' 'js/payment/*.js' 'functions/*.js' 'functions/lib/*.js' 'functions/payment/*.js' 'functions/messaging/*.js' 'tests/**/*.mjs' 'docs/*.md' 'README.md' '.github/**/*.yml' 'firebase.json' 'firestore.indexes.json' 'storage.cors.json'",
    "test": "npm run format:check && npm run build && npm run validate && node --test tests/unit/*.test.mjs",
    "test:integration": "firebase emulators:exec --project demo-medad-audit --only auth,firestore,storage \"node --test --test-concurrency=1 tests/integration/*.test.mjs\"",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "workspaces": [
    "functions"
  ],
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "esbuild": "0.28.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
