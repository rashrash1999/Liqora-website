# Protects POST /api/orders/paid. Never expose this value in browser JavaScript.
PAID_ORDER_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Saudi mobile number that receives paid-order alerts.
ORDER_ALERT_RECIPIENT=05XXXXXXXX

# sms | whatsapp
UNIFONIC_CHANNEL=sms

# --- Unifonic SMS ---
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# --- Unifonic WhatsApp (required only when UNIFONIC_CHANNEL=whatsapp) ---
UNIFONIC_PUBLIC_ID=
UNIFONIC_SECRET=
UNIFONIC_WHATSAPP_TEMPLATE=paid_order_alert
UNIFONIC_WHATSAPP_LANGUAGE=ar

# Optional but strongly recommended in production for durable webhook de-duplication.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IDEMPOTENCY_TTL_SECONDS=86400
