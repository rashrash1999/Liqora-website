# هذه القيم تخص الخادم فقط. لا تضمّن الأسرار في JavaScript المرسل للمتصفح.
APP_ENV=development
APP_URL=http://localhost:8080
API_BASE_URL=http://localhost:3000/api/v1
DATABASE_URL=postgresql://user:password@localhost:5432/medad

# الدفع — اختر مزودًا معتمدًا في المملكة
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# WhatsApp Business Platform أو مزود رسمي
WHATSAPP_PROVIDER=
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# تخزين الملفات والمهام الخلفية
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
REDIS_URL=

# المصادقة — خزّن hash فقط ولا تستخدم كلمة مرور العرض التجريبية
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-server-secret
OTP_PROVIDER=
OTP_API_KEY=

# توقيع روابط RSVP وQR
INVITATION_TOKEN_SECRET=replace-with-a-long-random-server-secret
