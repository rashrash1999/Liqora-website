rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
  function orderPath(orderId) { return /databases/(default)/documents/orders/$(orderId); }
  function uploadPath(fileName) { return /databases/(default)/documents/uploads/$(fileName); }
  function owner(orderId) {
   let orderDoc = firestore.get(orderPath(orderId));
   return request.auth != null && orderDoc != null && orderDoc.data.ownerUid == request.auth.uid;
  }
  function editable(orderDoc) {
   return orderDoc != null && !(orderDoc.data.status in ['active', 'cancelled', 'completed']);
  }
  function validFile(uploadDoc, orderId, kind) {
   return uploadDoc != null && resource == null && request.resource != null && request.auth != null && uploadDoc.data.ownerUid == request.auth.uid && uploadDoc.data.orderId == orderId && uploadDoc.data.kind == kind && uploadDoc.data.status == 'pending' && uploadDoc.data.expiresAt > request.time.toMillis() && request.resource.size == uploadDoc.data.size && request.resource.contentType == uploadDoc.data.contentType && request.resource.metadata.size() == 0;
  }
  function validReferenceCreate(orderId, fileName) {
   let orderDoc = firestore.get(orderPath(orderId));
   let uploadDoc = firestore.get(uploadPath(fileName));
   return request.auth != null && editable(orderDoc) && orderDoc.data.ownerUid == request.auth.uid && validFile(uploadDoc, orderId, 'reference');
  }
  function validDesignCreate(orderId, fileName) {
   let orderDoc = firestore.get(orderPath(orderId));
   let uploadDoc = firestore.get(uploadPath(fileName));
   return admin() && editable(orderDoc) && orderDoc.data.paymentStatus == 'paid' && validFile(uploadDoc, orderId, 'design');
  }
  match /orders/{orderId}/references/{fileName} {
   allow read: if admin() || owner(orderId);
   allow create: if validReferenceCreate(orderId, fileName);
   allow update, delete: if false;
  }
  match /orders/{orderId}/design/{fileName} {
   allow read: if admin() || owner(orderId);
   allow create: if validDesignCreate(orderId, fileName);
   allow update, delete: if false;
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
