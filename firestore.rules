rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
  function verifiedCustomer() {
   return signedIn() && (
    request.auth.token.get('email_verified', false) == true ||
    request.auth.token.get('phone_number', '') != ''
   );
  }
  function owner(orderId) { return verifiedCustomer() && get(/databases/$(database)/documents/orders/$(orderId)).data.ownerUid == request.auth.uid; }
  match /orders/{orderId} {
   allow get, list: if admin() || (verifiedCustomer() && resource.data.ownerUid == request.auth.uid);
   // All mutations are validated in callable functions; even admins cannot write from a browser.
   allow create, update, delete: if false;
   match /guests/{guestId} { allow read: if admin() || owner(orderId); allow write: if false; }
   match /notifications/{notificationId} { allow read: if admin() || owner(orderId); allow write: if false; }
   match /guestContacts/{guestId} { allow read, write: if false; }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
