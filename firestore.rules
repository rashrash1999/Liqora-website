rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
  function owner(orderId) { return signedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.ownerUid == request.auth.uid; }
  match /orders/{orderId} {
   allow get, list: if signedIn() && (admin() || resource.data.ownerUid == request.auth.uid);
   // All mutations are validated in callable functions; even admins cannot write from a browser.
   allow create, update, delete: if false;
   match /guests/{guestId} { allow read: if admin() || owner(orderId); allow write: if false; }
   match /guestContacts/{guestId} { allow read, write: if false; }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
